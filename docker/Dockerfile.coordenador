FROM python:3.11-slim
LABEL maintainer="Aggilli Intelligence <dev@aggilli.com.br>"
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev curl && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "flwr>=1.8.0" "fastapi>=0.111.0" "uvicorn[standard]>=0.29.0" \
    "httpx>=0.27.0" "psycopg2-binary>=2.9.9" "sqlalchemy>=2.0.29" \
    "redis>=5.0.4" "numpy>=1.26.4" "structlog>=24.1.0" \
    "prometheus-client>=0.20.0" "pydantic>=2.7.0" \
    "python-dotenv>=1.0.1" "typer>=0.12.3" "rich>=13.7.1" \
    "requests>=2.31.0"

COPY coordenador/ ./coordenador/
COPY no/ ./no/

# Garante que o módulo coordenador é encontrado
ENV PYTHONPATH=/app

EXPOSE 9090 8080 8000

CMD ["uvicorn", "coordenador.api:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]

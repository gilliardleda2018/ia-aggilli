ANI_HOST=0.0.0.0
ANI_PORT=9090
ANI_ROUNDS=10000
ANI_NOS_MINIMOS=2
DATABASE_URL=postgresql://ani:ani@localhost:5432/ani
REDIS_URL=redis://localhost:6379/0
